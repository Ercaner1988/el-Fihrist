#!/bin/sh
# Kalite kapisi — push oncesi.
#
# post-commit ve post-push bloklamaz ve bloklamamali: onlar arka planda pasli
# tetikler, senkron yapmak GitHub Desktop'i kilitler (desktop#8847).
# pre-push farklidir. Arka planda bir sey baslatmaz; kontrolleri calistirir,
# biter, sonucunu cikis koduyla soyler. Bloklamasi isin ta kendisidir.
#
# Kontrol listesi burada TEKRARLANMAZ. .github/workflows/ci.yml icindeki
# `run: cargo …` satirlari okunup aynen calistirilir; boylece "CI'da var,
# yerelde yok" durumu olusamaz. agent-reach-rs'te ayni sorun once bir kayma
# kapisiyla tespit ediliyordu — burada kaynak tek oldugu icin hic olusmuyor.
#
# Atlatma (ikisi de bilincli ve gorunur):
#   git push --no-verify
#   FIHRIST_SKIP_GATE=1 git push

[ -n "$FIHRIST_SKIP_GATE" ] && {
  echo "pre-push: FIHRIST_SKIP_GATE ayarli — kapi atlandi." >&2
  exit 0
}

# Yalniz silme itiyorsan calistiracak bir sey yok. pre-push stdin'den
# "<yerel ref> <yerel sha> <uzak ref> <uzak sha>" alir; silmede yerel sha sifirdir.
itilecek=0
while read -r _lref lsha _rref _rsha; do
  case "$lsha" in
    "" | 0000000000000000000000000000000000000000) ;;
    *) itilecek=1 ;;
  esac
done
[ "$itilecek" = 1 ] || exit 0

kok=$(git rev-parse --show-toplevel) || exit 0
cd "$kok" || exit 0

CI=".github/workflows/ci.yml"
[ -f "$CI" ] || {
  echo "pre-push: $CI yok — kontrol listesi okunamadi, kapi OLCMEDI." >&2
  exit 0
}

# Cargo'yu PATH'te ara, sonra rustup'in standart yerinde. Ikinci adim GitHub
# Desktop icin: kancalari dar bir ortamla calistirir ve ~/.cargo/bin cogu zaman
# icinde olmaz. post-commit'in pasli.exe icin yaptiginin aynisi.
CARGO_BIN="$(command -v cargo 2>/dev/null || true)"
[ -n "$CARGO_BIN" ] || for c in "$HOME/.cargo/bin/cargo" "$USERPROFILE/.cargo/bin/cargo.exe"; do
  [ -x "$c" ] && { CARGO_BIN="$c"; break; }
done
[ -n "$CARGO_BIN" ] || {
  echo "pre-push: cargo bulunamadi — kapi OLCULMEDI (yesil degil). CI son savunma." >&2
  exit 0
}

# Ayni dar ortam sorunu, bu kez rc.exe icin. turso_sdk_kit'in build.rs'i once
# PATH'e, sonra ProgramFiles(x86)'ya bakar; GitHub Desktop ikisini de vermez ve
# derleme "rc.exe was not found in PATH and ProgramFiles(x86) is not set" ile
# duser — oysa ayni komut normal kabukta yesil. Windows Kits'in en yeni x64
# bin'ini PATH'e ekle. Bulunamazsa dokunma: Linux/CI bu daldan hic gecmez.
# ponytail: yol C: varsayar; Kits baska surucudeyse burasi guncellenir.
command -v rc.exe >/dev/null 2>&1 || {
  RC_DIR=""
  for k in "/c/Program Files (x86)/Windows Kits/10/bin/"*/x64; do
    [ -x "$k/rc.exe" ] && RC_DIR="$k"
  done
  [ -n "$RC_DIR" ] && { PATH="$RC_DIR:$PATH"; export PATH; }
}

echo "pre-push: CI'in kontrolleri kosuyor (ag yok)…" >&2
basla=$(date +%s)

# CI'daki cargo satirlari. Komutlar sade tutuldugu icin tirnak/degisken yok;
# bolunmeyi kabuga birakmak eval'den guvenli (komut ikamesi calismaz).
sed -n 's/^[[:space:]]*run:[[:space:]]*cargo[[:space:]]\{1,\}//p' "$CI" > /tmp/.fihrist-ci-cmds.$$
sonuc=0
while IFS= read -r argv; do
  [ -n "$argv" ] || continue
  echo "-- cargo $argv" >&2
  # shellcheck disable=SC2086
  if "$CARGO_BIN" $argv >&2; then
    echo "   yesil" >&2
  else
    echo "   KIRMIZI: cargo $argv" >&2
    sonuc=1
    break
  fi
done < /tmp/.fihrist-ci-cmds.$$
rm -f /tmp/.fihrist-ci-cmds.$$

echo "pre-push: kapi $(( $(date +%s) - basla )) sn surdu." >&2

[ "$sonuc" = 0 ] || {
  echo "" >&2
  echo "PUSH DURDURULDU — kapi kirmizi. Ayrinti yukarida." >&2
  echo "  Bicim ise  : cargo fmt --all" >&2
  echo "  Yine de it : git push --no-verify" >&2
  exit 1
}

exit 0
