{
  "name": "el-fihrist",
  "version": "1.0.0",
  "description": "el-Fihrist (İbnü'n-Nedîm): Turso SQLite tabanlı yapay zekâ yetenek, araç, prompt ve hafıza kütüphanesi motoru.",
  "main": "crates/hermes-tools-core/src/lib.rs",
  "type": "module",
  "mcpServers": {
    "el-fihrist": {
      "command": "ibnunnedim",
      "args": [
        "mcp"
      ]
    },
    "graphify": {
      "command": "graphify-rs",
      "args": [
        "serve",
        "--graph",
        "graphify-rs-out/graph.json"
      ],
      "env": {}
    }
  },
  "hermes": {
    "plugin": true,
    "tools": [
      "search_skills",
      "list_skills",
      "tekmil_ver",
      "info"
    ],
    "supported_platforms": [
      "hermes-agent",
      "claude-desktop",
      "deepseek-harness",
      "opencode",
      "codex"
    ],
    "graphify_tools": [
      "query_graph",
      "explore",
      "graph_stats",
      "god_nodes",
      "get_node",
      "get_neighbors",
      "get_community",
      "shortest_path",
      "find_all_paths",
      "weighted_path",
      "community_bridges",
      "graph_diff",
      "pagerank",
      "detect_cycles",
      "smart_summary",
      "find_similar"
    ]
  }
}
